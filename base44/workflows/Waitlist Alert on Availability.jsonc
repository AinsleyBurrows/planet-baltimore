{
  "name": "Waitlist Alert on Availability",
  "description": "When a TicketType's inventory opens up (quantity added or sold count drops), alert the first person on that ticket type's waitlist.",
  "trigger": {
    "condition": "${ ((.trigger.changed_fields | index(\"quantity_total\") != null) or (.trigger.changed_fields | index(\"quantity_sold\") != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "update"
      ],
      "entity_name": "TicketType"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "waitlist_alert_on_availability",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyWaitlistAvailability",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyWaitlistAvailability"
  }
}