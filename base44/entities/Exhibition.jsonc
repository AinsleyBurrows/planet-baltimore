{
  "name": "Exhibition",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "exhibition_type": {
      "type": "string",
      "enum": [
        "solo",
        "group",
        "booth",
        "fair",
        "residency",
        "other"
      ],
      "default": "solo"
    },
    "reception_date": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "installation_shots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "works": {
      "type": "array",
      "description": "Individual artworks included in this exhibition",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Artwork name / title"
          },
          "year": {
            "type": "string"
          },
          "medium": {
            "type": "string"
          },
          "dimensions": {
            "type": "string",
            "description": "Size / dimensions, e.g. 24 \u00d7 36 in"
          },
          "image_url": {
            "type": "string"
          }
        }
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "artist_id",
    "title"
  ]
}