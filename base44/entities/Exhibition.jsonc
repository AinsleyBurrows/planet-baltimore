{
  "name": "Exhibition",
  "type": "object",
  "properties": {
    "artist_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "venue": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "exhibition_type": {
      "type": "string",
      "enum": [
        "solo",
        "group",
        "booth",
        "fair",
        "residency",
        "other"
      ],
      "default": "solo"
    },
    "reception_date": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "installation_shots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "artist_id",
    "title"
  ]
}