{
  "name": "Magazine",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Magazine title"
    },
    "issue_label": {
      "type": "string",
      "description": "Issue label, e.g. 'Issue 01'"
    },
    "tagline": {
      "type": "string",
      "description": "Short line shown on the cover card"
    },
    "description": {
      "type": "string",
      "description": "About this magazine"
    },
    "cover_image_url": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_avatar": {
      "type": "string"
    },
    "cover": {
      "type": "object",
      "description": "Designed cover, laid out with the same elements as a page but half the height",
      "properties": {
        "id": {
          "type": "string"
        },
        "bg_color": {
          "type": "string",
          "default": "#ffffff"
        },
        "blocks": {
          "type": "array",
          "description": "Cover elements in reading order. Image and advert blocks float and the text flows around them.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "headline",
                  "subhead",
                  "body",
                  "quote",
                  "caption",
                  "image",
                  "advert"
                ]
              },
              "text": {
                "type": "string",
                "description": "Text content, or the advert copy for advert blocks"
              },
              "url": {
                "type": "string",
                "description": "Image URL, or the destination link for advert blocks"
              },
              "caption": {
                "type": "string"
              },
              "float": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "full"
                ],
                "default": "full"
              },
              "width": {
                "type": "number",
                "default": 100
              },
              "advertiser": {
                "type": "string",
                "description": "Sponsor or business name shown on an advert block"
              },
              "cta": {
                "type": "string",
                "description": "Call-to-action label on an advert block"
              }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "description": "Magazine pages in reading order",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "bg_color": {
            "type": "string",
            "default": "#ffffff"
          },
          "blocks": {
            "type": "array",
            "description": "Content blocks in reading order. Image and advert blocks float and the text flows around them.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "headline",
                    "subhead",
                    "body",
                    "quote",
                    "caption",
                    "image",
                    "advert"
                  ]
                },
                "text": {
                  "type": "string",
                  "description": "Text content, or the advert copy for advert blocks"
                },
                "url": {
                  "type": "string",
                  "description": "Image URL, or the destination link for advert blocks"
                },
                "caption": {
                  "type": "string"
                },
                "float": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right",
                    "full"
                  ],
                  "default": "full"
                },
                "width": {
                  "type": "number",
                  "default": 100
                },
                "advertiser": {
                  "type": "string",
                  "description": "Sponsor or business name shown on an advert block"
                },
                "cta": {
                  "type": "string",
                  "description": "Call-to-action label on an advert block"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "owner_id"
  ]
}