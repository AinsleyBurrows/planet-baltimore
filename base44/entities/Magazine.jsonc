{
  "name": "Magazine",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Magazine title"
    },
    "issue_label": {
      "type": "string",
      "description": "Issue label, e.g. 'Issue 01'"
    },
    "tagline": {
      "type": "string",
      "description": "Short line shown on the cover card"
    },
    "description": {
      "type": "string",
      "description": "About this magazine"
    },
    "cover_image_url": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "owner_avatar": {
      "type": "string"
    },
    "cover": {
      "type": "object",
      "description": "Designed cover, laid out with the same elements as a page but half the height",
      "properties": {
        "id": {
          "type": "string"
        },
        "bg_color": {
          "type": "string",
          "default": "#ffffff"
        },
        "blocks": {
          "type": "array",
          "description": "Cover elements in reading order. Image and advert blocks float and the text flows around them; elements with overlay sit on top of the cover photo instead of in the column.",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "type": {
                "type": "string",
                "enum": [
                  "masthead",
                  "headline",
                  "subhead",
                  "body",
                  "quote",
                  "caption",
                  "image",
                  "advert"
                ]
              },
              "text": {
                "type": "string",
                "description": "Text content, or the advert copy for advert blocks. The masthead falls back to the magazine's own title when left empty."
              },
              "url": {
                "type": "string",
                "description": "Image URL, or the destination link for advert blocks"
              },
              "caption": {
                "type": "string"
              },
              "float": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "full"
                ],
                "default": "full",
                "description": "Wrap the element beside the text on the left or right, or give it the full column"
              },
              "width": {
                "type": "number",
                "default": 100,
                "description": "Width of the element as a percentage of the column"
              },
              "align": {
                "type": "string",
                "enum": [
                  "left",
                  "center",
                  "right"
                ],
                "description": "Alignment of the element's text"
              },
              "space_before": {
                "type": "number",
                "default": 0,
                "description": "Extra space above the element, 0 (none) to 4 (most)"
              },
              "overlay": {
                "type": "boolean",
                "default": false,
                "description": "Lay this element over the cover photo instead of in the column"
              },
              "overlay_anchor": {
                "type": "string",
                "enum": [
                  "top",
                  "middle",
                  "bottom"
                ],
                "default": "top",
                "description": "Where the overlaid element sits on the sheet"
              },
              "overlay_layer": {
                "type": "string",
                "enum": [
                  "front",
                  "behind"
                ],
                "default": "front",
                "description": "Overlaid elements sit in front of the cover photo, or behind it so the photo laps over them"
              },
              "text_color": {
                "type": "string",
                "description": "Text colour for cover lines; empty means the element's own colour"
              },
              "shadow": {
                "type": "boolean",
                "default": false,
                "description": "Drop shadow behind the text, to keep it legible over a photo"
              },
              "bleed": {
                "type": "boolean",
                "default": false,
                "description": "Run the photo to the edges of the sheet"
              },
              "advertiser": {
                "type": "string",
                "description": "Sponsor or business name shown on an advert block"
              },
              "cta": {
                "type": "string",
                "description": "Call-to-action label on an advert block"
              }
            }
          }
        }
      }
    },
    "pages": {
      "type": "array",
      "description": "Magazine pages in reading order",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "bg_color": {
            "type": "string",
            "default": "#ffffff"
          },
          "blocks": {
            "type": "array",
            "description": "Content blocks in reading order. Image and advert blocks float and the text flows around them.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "headline",
                    "subhead",
                    "body",
                    "quote",
                    "caption",
                    "image",
                    "advert",
                    "continued_on",
                    "continued_from"
                  ]
                },
                "text": {
                  "type": "string",
                  "description": "Text content, the advert copy for advert blocks, or an override for a continuation cue"
                },
                "url": {
                  "type": "string",
                  "description": "Image URL, or the destination link for advert blocks"
                },
                "caption": {
                  "type": "string"
                },
                "float": {
                  "type": "string",
                  "enum": [
                    "left",
                    "right",
                    "full"
                  ],
                  "default": "full",
                  "description": "Wrap the element beside the text on the left or right, or give it the full column"
                },
                "width": {
                  "type": "number",
                  "default": 100,
                  "description": "Width of the element as a percentage of the column"
                },
                "align": {
                  "type": "string",
                  "enum": [
                    "left",
                    "center",
                    "right"
                  ],
                  "description": "Alignment of the element's text"
                },
                "space_before": {
                  "type": "number",
                  "default": 0,
                  "description": "Extra space above the element, 0 (none) to 4 (most)"
                },
                "advertiser": {
                  "type": "string",
                  "description": "Sponsor or business name shown on an advert block"
                },
                "cta": {
                  "type": "string",
                  "description": "Call-to-action label on an advert block"
                }
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "title",
    "owner_id"
  ]
}