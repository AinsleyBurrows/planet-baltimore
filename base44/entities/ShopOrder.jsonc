{
  "name": "ShopOrder",
  "type": "object",
  "properties": {
    "order_number": {
      "type": "string",
      "description": "Human readable order number, e.g. PB-8KD2LQ"
    },
    "business_id": {
      "type": "string",
      "description": "BusinessPage the order was placed with"
    },
    "business_name": {
      "type": "string"
    },
    "seller_email": {
      "type": "string",
      "description": "Business owner email, for order notifications"
    },
    "buyer_id": {
      "type": "string"
    },
    "buyer_name": {
      "type": "string"
    },
    "buyer_email": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "description": "Line items purchased",
      "items": {
        "type": "object",
        "properties": {
          "shop_item_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "image_url": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number"
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number"
    },
    "shipping": {
      "type": "object",
      "description": "Delivery address captured at checkout",
      "properties": {
        "name": {
          "type": "string"
        },
        "address1": {
          "type": "string"
        },
        "address2": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "zip": {
          "type": "string"
        },
        "phone": {
          "type": "string"
        }
      }
    },
    "payment_intent_id": {
      "type": "string"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "pending",
        "paid",
        "failed",
        "refunded"
      ],
      "default": "pending"
    }
  },
  "required": [
    "business_id",
    "buyer_id",
    "total"
  ]
}